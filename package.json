{
  "name": "collectiviq-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible gateway between OpenCode and CollectivIQ (runnable foundation).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:contract": "vitest run test/contract",
    "test:compatibility": "vitest run -c vitest.compatibility.config.ts",
    "test:adversarial": "vitest run -c vitest.adversarial.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:build": "node test/smoke/import-built.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:build",
    "contract:openapi:refresh": "tsx scripts/openapi/refresh.ts",
    "contract:openapi:check": "tsx scripts/openapi/check.ts",
    "contract:discovery": "tsx src/collectiviq/discovery-cli.ts",
    "contract:discovery:cleanup": "tsx src/collectiviq/discovery-recovery-cli.ts",
    "eval:tools": "tsx src/eval/tools-eval-cli.ts",
    "eval:tools:diagnose": "tsx src/eval/tools-diagnostic-cli.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.11.2",
    "pino": "10.3.1",
    "typebox": "1.3.10",
    "ulid": "2.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "ai": "6.0.168",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
