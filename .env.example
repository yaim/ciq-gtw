# Example environment for the CollectivIQ gateway scaffold.
#
# Copy to .env for local development (.env is git-ignored). Every value here is
# a FAKE placeholder — replace the credentials with your own and never commit
# real secrets.

# development | staging | production. LOG_CONTENT=true is only accepted when
# ENVIRONMENT=development (and even then this scaffold logs no content).
ENVIRONMENT=development

# Native local runs bind to loopback. The Docker image sets HOST=0.0.0.0 while
# Compose publishes only to host loopback.
HOST=127.0.0.1
PORT=8787

COLLECTIVIQ_BASE_URL=https://api.prod.collectiviq.ai

# Upstream authentication mode: bearer | password. Default: bearer.
#   bearer   -> uses COLLECTIVIQ_API_KEY as a static bearer token on every request.
#   password -> exchanges COLLECTIVIQ_USERNAME + COLLECTIVIQ_PASSWORD at
#               POST /login for a short-lived bearer token (held in memory only).
# The inactive mode's credentials may be left set but are ignored.
COLLECTIVIQ_AUTH_MODE=bearer

# Upstream credential for bearer mode (authenticates the gateway to CollectivIQ).
# FAKE value. Required when COLLECTIVIQ_AUTH_MODE=bearer.
COLLECTIVIQ_API_KEY=sk-fake-upstream-key-change-me

# Upstream credentials for password mode. FAKE values. Required (both) when
# COLLECTIVIQ_AUTH_MODE=password. The password is preserved exactly (including
# any whitespace); the username is trimmed.
COLLECTIVIQ_USERNAME=fake-user@example.com
COLLECTIVIQ_PASSWORD=fake-password-change-me

# Client credentials (authenticate OpenCode to the gateway). Comma-separated;
# FAKE value. Keep separate from the upstream credentials above.
COLLECTIVIQ_GATEWAY_KEYS=gw-fake-key-change-me

MODEL_CONFIG_PATH=./config/models.yaml

LOG_LEVEL=info
LOG_CONTENT=false

MAX_REQUEST_BODY_BYTES=8388608

# Process-local capacity and backpressure for POST /v1/chat/completions.
# These bound in-flight and queued work PER PROCESS (not across replicas).
# MAX_CONCURRENT_REQUESTS_PER_KEY must not exceed MAX_CONCURRENT_REQUESTS.
MAX_CONCURRENT_REQUESTS=4
MAX_CONCURRENT_REQUESTS_PER_KEY=2
MAX_QUEUED_REQUESTS=20
MAX_QUEUE_WAIT_MS=5000

# Graceful-shutdown drain period (ms). In-flight completions get this long to
# finish after SIGTERM/SIGINT before their polling is cancelled.
SHUTDOWN_DRAIN_MS=30000

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed cross-replica idempotency for POST /v1/chat/completions
# (Phase 4A). Leave REDIS_URL blank to disable Redis entirely: unkeyed requests
# behave exactly as they did before, and a supplied `Idempotency-Key` header
# fails closed with 503 idempotency_unavailable.
#
# Only canonical redis:// and rediss:// URLs are accepted. The value may embed
# credentials and is treated as secret-bearing (redacted everywhere).
REDIS_URL=

# REQUIRED whenever REDIS_URL is set. Exactly 32 bytes encoded as canonical
# unpadded base64url (43 characters). Every cached final response is encrypted
# with AES-256-GCM under keys derived from this master key.
#
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Deliberately BLANK: this file must never ship a usable key. Copying it and
# setting REDIS_URL without generating your own key fails startup loudly with
# `IDEMPOTENCY_ENCRYPTION_KEY: is required`, which is the intended behaviour —
# a placeholder that happened to work would mean deploying with a key published
# in this repository. Leaving it blank is also fine while Redis is disabled.
#
# ALL replicas must share the SAME key, REDIS_KEY_PREFIX, Redis endpoint,
# COLLECTIVIQ_GATEWAY_KEYS, and model configuration. Mixed keys during a rolling
# deployment are not supported; rotating the key requires draining traffic and
# waiting at least one IDEMPOTENCY_TTL_MS.
IDEMPOTENCY_ENCRYPTION_KEY=

# Lifetime of a cached final response, in ms (60000-3600000). Replay protection
# is bounded to this window. When Redis is enabled this must also be at least the
# largest model requestTimeoutMs, so a client retrying after its own timeout
# still finds the cached result instead of paying for a duplicate completion.
IDEMPOTENCY_TTL_MS=600000

# Redis key namespace (1-64 chars, [A-Za-z0-9_-]). Must match across replicas.
# Shared by every Redis-backed feature; idempotency and rate-limit keys live in
# separate `:idem:` and `:rate:` categories under it.
REDIS_KEY_PREFIX=collectiviq-gateway

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed cross-replica per-gateway-key rate limiting for
# POST /v1/chat/completions (Phase 4B). OFF by default: with
# RATE_LIMIT_ENABLED=false the gateway performs no limiter or Redis rate-limit
# operation at all and behaves exactly as it did before Phase 4B.
#
# Setting this to true REQUIRES a valid REDIS_URL above (and therefore
# IDEMPOTENCY_ENCRYPTION_KEY, from which a SEPARATE rate-limit subkey is
# derived). Startup fails with a value-free error otherwise. Only "true" or
# "false" are accepted.
#
# Every otherwise-valid completion attempt consumes exactly one unit — including
# an idempotency owner, a waiter, a cached replay, and a body conflict. Invalid
# authentication, invalid requests, preparation failures, and invalid
# Idempotency-Key inputs consume nothing. Exceeding the limit returns
# 429 gateway_rate_limit_exceeded with a computed Retry-After; an unavailable
# Redis fails CLOSED with 503 rate_limit_unavailable + Retry-After: 2.
#
# ALL replicas must share the same REDIS_URL, IDEMPOTENCY_ENCRYPTION_KEY,
# REDIS_KEY_PREFIX, COLLECTIVIQ_GATEWAY_KEYS, and rate-limit settings, or the
# quota will not be the single shared quota it appears to be.
RATE_LIMIT_ENABLED=false

# Sustained requests admitted per window, per gateway key (1-100000).
RATE_LIMIT_REQUESTS=60

# The window the sustained rate is expressed over, in ms (1000-3600000).
RATE_LIMIT_WINDOW_MS=60000

# Requests admitted immediately from an idle key (1-10000, and never greater
# than RATE_LIMIT_REQUESTS). With the defaults above a burst of 8 is admitted at
# once and the allowance then refills at one request per second.
RATE_LIMIT_BURST=8

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed OpenCode thread reuse (Phase 5A, pulled forward).
# OFF by default: with OPENCODE_THREAD_REUSE_ENABLED=false every completion
# creates its own CollectivIQ thread, exactly as before, and no reuse Redis
# operation ever runs.
#
# When enabled, sequential ELIGIBLE messages from one OpenCode session reuse ONE
# CollectivIQ thread instead of creating one per completion. A request is
# eligible only when ALL of these hold:
#   * this setting is true;
#   * the request carries a valid X-CollectivIQ-OpenCode-Session-ID header;
#   * the resolved virtual model uses promptMode: direct;
#   * the resolved virtual model uses toolMode: disabled.
# Every other request — no header, a protocol-mode model, or a tool-enabled
# model — stays stateless and byte-for-byte unchanged.
#
# Setting this to true REQUIRES a valid REDIS_URL above (and therefore
# IDEMPOTENCY_ENCRYPTION_KEY, from which SEPARATE thread-reuse subkeys are
# derived). Startup fails with a value-free error otherwise. Only "true" or
# "false" are accepted. No new secret is introduced.
#
# It is FAIL-CLOSED: an unavailable Redis, corrupt or ambiguous mapping state,
# or a failed transition returns 503 thread_reuse_unavailable + Retry-After: 2
# rather than silently starting a replacement thread. A second concurrent turn
# for the same session returns 409 thread_reuse_busy + Retry-After: 2. An
# eligible request that ALSO supplies Idempotency-Key is rejected with 400,
# because the two features cannot be combined in this initial implementation.
#
# This is NOT production ready: the remaining Phase 4 controls (metrics,
# tracing, shared capacity accounting, load and security review, dependency
# scanning, runbooks) are still outstanding, and upstream message ordering,
# pagination, thread cleanup, and retention remain unverified.
#
# Before enabling, know two things:
#   * Answers are matched by run id: every completion records the
#     combined_run_id its submission returned and accepts only messages carrying
#     that same id, so a reused thread cannot yield an earlier turn's answer. If
#     your account's process_message omits combined_run_id the submission fails
#     as an upstream protocol error; if its messages omit it, every turn times
#     out with 504.
#   * In direct mode the gateway sends only the latest user message. Without
#     reuse the provider therefore has no history and OpenCode's transcript is
#     the only conversation state; WITH reuse the provider accumulates the
#     session's turns and answers with them in view. The two are never
#     reconciled, so an edited or truncated client transcript can diverge from
#     what the provider remembers.
#
# ALL replicas must share the same REDIS_URL, IDEMPOTENCY_ENCRYPTION_KEY,
# REDIS_KEY_PREFIX, COLLECTIVIQ_GATEWAY_KEYS, upstream credentials, and model
# configuration, or a session will not resolve to the same mapping everywhere.
OPENCODE_THREAD_REUSE_ENABLED=false

# Sliding idle lifetime of a session-to-thread mapping, in ms
# (300000-2592000000; default 7 days). Every completion that uses the mapping
# resets it. Expiry only forgets the mapping — it NEVER deletes the CollectivIQ
# thread, which remains in the provider's sidebar under the provider's own
# retention policy. There is deliberately NO cap on the number of turns a
# mapping may serve.
OPENCODE_THREAD_REUSE_TTL_MS=604800000
