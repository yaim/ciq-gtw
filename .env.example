# Example environment for the CollectivIQ gateway scaffold.
#
# Copy to .env for local development (.env is git-ignored). Every value here is
# a FAKE placeholder — replace the credentials with your own and never commit
# real secrets.

# development | staging | production. LOG_CONTENT=true is only accepted when
# ENVIRONMENT=development (and even then this scaffold logs no content).
ENVIRONMENT=development

# Native local runs bind to loopback. The Docker image sets HOST=0.0.0.0 while
# Compose publishes only to host loopback.
HOST=127.0.0.1
PORT=8787

COLLECTIVIQ_BASE_URL=https://api.prod.collectiviq.ai

# Upstream authentication mode: bearer | password. Default: bearer.
#   bearer   -> uses COLLECTIVIQ_API_KEY as a static bearer token on every request.
#   password -> exchanges COLLECTIVIQ_USERNAME + COLLECTIVIQ_PASSWORD at
#               POST /login for a short-lived bearer token (held in memory only).
# The inactive mode's credentials may be left set but are ignored.
COLLECTIVIQ_AUTH_MODE=bearer

# Upstream credential for bearer mode (authenticates the gateway to CollectivIQ).
# FAKE value. Required when COLLECTIVIQ_AUTH_MODE=bearer.
COLLECTIVIQ_API_KEY=sk-fake-upstream-key-change-me

# Upstream credentials for password mode. FAKE values. Required (both) when
# COLLECTIVIQ_AUTH_MODE=password. The password is preserved exactly (including
# any whitespace); the username is trimmed.
COLLECTIVIQ_USERNAME=fake-user@example.com
COLLECTIVIQ_PASSWORD=fake-password-change-me

# Client credentials (authenticate OpenCode to the gateway). Comma-separated;
# FAKE value. Keep separate from the upstream credentials above.
COLLECTIVIQ_GATEWAY_KEYS=gw-fake-key-change-me

MODEL_CONFIG_PATH=./config/models.yaml

LOG_LEVEL=info
LOG_CONTENT=false

MAX_REQUEST_BODY_BYTES=8388608

# Capacity and backpressure for POST /v1/chat/completions.
#
# By default all four of these bound in-flight and queued work PER PROCESS (not
# across replicas), so N replicas admit up to N times these limits. Setting
# SHARED_CAPACITY_ENABLED=true (see its block below) makes only the two ACTIVE
# limits — MAX_CONCURRENT_REQUESTS and MAX_CONCURRENT_REQUESTS_PER_KEY —
# CLUSTER-WIDE; MAX_QUEUED_REQUESTS and MAX_QUEUE_WAIT_MS stay per replica in
# both modes. Re-size the two active limits before enabling that feature.
#
# MAX_CONCURRENT_REQUESTS_PER_KEY must not exceed MAX_CONCURRENT_REQUESTS.
MAX_CONCURRENT_REQUESTS=4
MAX_CONCURRENT_REQUESTS_PER_KEY=2
MAX_QUEUED_REQUESTS=20
MAX_QUEUE_WAIT_MS=5000

# Graceful-shutdown drain period (ms). In-flight completions get this long to
# finish after SIGTERM/SIGINT before their polling is cancelled.
SHUTDOWN_DRAIN_MS=30000

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed cross-replica idempotency for POST /v1/chat/completions
# (Phase 4A). Leave REDIS_URL blank to disable Redis entirely: unkeyed requests
# behave exactly as they did before, and a supplied `Idempotency-Key` header
# fails closed with 503 idempotency_unavailable.
#
# Only canonical redis:// and rediss:// URLs are accepted. The value may embed
# credentials and is treated as secret-bearing (redacted everywhere).
REDIS_URL=

# REQUIRED whenever REDIS_URL is set. Exactly 32 bytes encoded as canonical
# unpadded base64url (43 characters). Every cached final response is encrypted
# with AES-256-GCM under keys derived from this master key.
#
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Deliberately BLANK: this file must never ship a usable key. Copying it and
# setting REDIS_URL without generating your own key fails startup loudly with
# `IDEMPOTENCY_ENCRYPTION_KEY: is required`, which is the intended behaviour —
# a placeholder that happened to work would mean deploying with a key published
# in this repository. Leaving it blank is also fine while Redis is disabled.
#
# ALL replicas must share the SAME key, REDIS_KEY_PREFIX, Redis endpoint,
# COLLECTIVIQ_GATEWAY_KEYS, and model configuration. Mixed keys during a rolling
# deployment are not supported; rotating the key requires draining traffic and
# waiting at least one IDEMPOTENCY_TTL_MS.
IDEMPOTENCY_ENCRYPTION_KEY=

# Lifetime of a cached final response, in ms (60000-3600000). Replay protection
# is bounded to this window. When Redis is enabled this must also be at least the
# largest model requestTimeoutMs, so a client retrying after its own timeout
# still finds the cached result instead of paying for a duplicate completion.
IDEMPOTENCY_TTL_MS=600000

# Redis key namespace (1-64 chars, [A-Za-z0-9_-]). Must match across replicas.
# Shared by every Redis-backed feature, each of which lives in its own category
# under it: `:idem:` (idempotency), `:rate:` (rate limiting), `:capacity:`
# (shared capacity), and `:reuse:` (thread reuse).
REDIS_KEY_PREFIX=collectiviq-gateway

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed cross-replica per-gateway-key rate limiting for
# POST /v1/chat/completions (Phase 4B). OFF by default: with
# RATE_LIMIT_ENABLED=false the gateway performs no limiter or Redis rate-limit
# operation at all and behaves exactly as it did before Phase 4B.
#
# Setting this to true REQUIRES a valid REDIS_URL above (and therefore
# IDEMPOTENCY_ENCRYPTION_KEY, from which a SEPARATE rate-limit subkey is
# derived). Startup fails with a value-free error otherwise. Only "true" or
# "false" are accepted.
#
# Every otherwise-valid completion attempt consumes exactly one unit — including
# an idempotency owner, a waiter, a cached replay, and a body conflict. Invalid
# authentication, invalid requests, preparation failures, and invalid
# Idempotency-Key inputs consume nothing. Exceeding the limit returns
# 429 gateway_rate_limit_exceeded with a computed Retry-After; an unavailable
# Redis fails CLOSED with 503 rate_limit_unavailable + Retry-After: 2.
#
# ALL replicas must share the same REDIS_URL, IDEMPOTENCY_ENCRYPTION_KEY,
# REDIS_KEY_PREFIX, COLLECTIVIQ_GATEWAY_KEYS, and rate-limit settings, or the
# quota will not be the single shared quota it appears to be.
RATE_LIMIT_ENABLED=false

# Sustained requests admitted per window, per gateway key (1-100000).
RATE_LIMIT_REQUESTS=60

# The window the sustained rate is expressed over, in ms (1000-3600000).
RATE_LIMIT_WINDOW_MS=60000

# Requests admitted immediately from an idle key (1-10000, and never greater
# than RATE_LIMIT_REQUESTS). With the defaults above a burst of 8 is admitted at
# once and the allowance then refills at one request per second.
RATE_LIMIT_BURST=8

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed cross-replica ACTIVE-capacity accounting for
# POST /v1/chat/completions (Phase 4D). OFF by default: with
# SHARED_CAPACITY_ENABLED=false the gateway derives no capacity scope, builds no
# coordinator, and performs no Redis capacity operation at all — admission is
# byte-for-byte the process-local controller it has always been.
#
# When enabled, MAX_CONCURRENT_REQUESTS and MAX_CONCURRENT_REQUESTS_PER_KEY (see
# the capacity block above) are REINTERPRETED as CLUSTER-WIDE active limits
# enforced through one atomic Redis lease registry, so every replica competes for
# one shared budget. MAX_QUEUED_REQUESTS and MAX_QUEUE_WAIT_MS remain PER
# REPLICA, local FIFO order and per-key bypass are preserved, and NO cross-replica
# queue fairness is promised: a busy replica's queue does not yield to an idle one.
#
# RE-SIZE THE TWO ACTIVE LIMITS FIRST. With the defaults above and four replicas,
# enabling this takes the cluster's global active ceiling from an effective 16
# down to 4. That is the point of the feature, but raise the limits deliberately
# rather than discovering it as a throughput regression.
#
# Setting this to true REQUIRES a valid REDIS_URL above (and therefore
# IDEMPOTENCY_ENCRYPTION_KEY, from which a SEPARATE capacity subkey is derived).
# Startup fails with a value-free error otherwise — never a silent downgrade to
# per-replica limits. Only "true" or "false" are accepted, a present-but-invalid
# value is rejected even while the feature is disabled, and this is the ONLY
# setting the feature adds: no new secret, no new dependency, no tuning knob.
#
# Being at the cluster limit leaves a request QUEUED — ordinary backpressure, not
# a rejection. A full local queue, an exceeded queue wait, or shutdown still
# returns 429 gateway_capacity_exceeded + Retry-After: 5, identically in both
# modes. It is FAIL-CLOSED: an unavailable Redis, or corrupt or ambiguous registry
# state, returns 503 capacity_unavailable + Retry-After: 2 rather than admitting a
# request whose cluster occupancy is unknown, which would silently multiply your
# configured limit by the replica count.
#
# Operational requirements, all of which matter:
#   * ENABLING THIS — or changing either active limit — requires a COORDINATED
#     DRAIN/RESTART. Mixed rolling operation is UNSUPPORTED: while some replicas
#     count locally and others count cluster-wide, neither limit means what it
#     says.
#   * ALL replicas must share the same REDIS_URL, IDEMPOTENCY_ENCRYPTION_KEY,
#     REDIS_KEY_PREFIX, COLLECTIVIQ_GATEWAY_KEYS, SHARED_CAPACITY_ENABLED value,
#     and BOTH MAX_CONCURRENT_REQUESTS* limits, or the budget is not the single
#     shared budget it appears to be.
#   * `maxmemory-policy noeviction` is REQUIRED, as it already is for
#     idempotency. An evicted or otherwise lost registry key forgets live permits
#     and can briefly OVER-ADMIT up to your full configured limit again, and the
#     gateway cannot detect it. A Redis restart has the same effect. Persistence
#     and backups stay unnecessary: this is transient occupancy state.
#   * A failed or unacknowledged release conservatively UNDER-ADMITS that replica
#     until the lease expires; it never changes an already successful response.
#   * The active/queued metrics gauges stay PER INSTANCE. Summing them across
#     replicas approximates live cluster occupancy but cannot see an orphan lease
#     left by an ambiguous claim, so treat it as an estimate.
#
# Redis stores only a sorted set of `version|owner-token|capacity-scope` members
# scored by a lease deadline from Redis's own clock — no request, thread, session,
# model, prompt, answer, credential, or raw gateway key, and the registry key
# itself is an HMAC.
#
# EXERCISED AGAINST A REAL REDIS 8.8.2, AND ONLY THAT: `npm run test:redis` gains
# a fourth suite for this feature, test/redis/shared-capacity-store.test.ts, and
# the complete four-suite gate has now been run and passes (86/86 in the second
# of two approved local runs, disposable pinned redis:8.8.2-alpine with
# maxmemory-policy noeviction, database empty afterwards, every disposable
# resource removed). That
# is not a cross-version guarantee and not production readiness, the Phase 4 load
# gate is still outstanding so behaviour under sustained cross-replica contention
# is unverified, and every rerun needs fresh approval. Try this against a
# disposable Redis outside production first.
SHARED_CAPACITY_ENABLED=false

# ---------------------------------------------------------------------------
# OPTIONAL Redis-backed OpenCode thread reuse (Phase 5A, pulled forward).
# OFF by default: with OPENCODE_THREAD_REUSE_ENABLED=false every completion
# creates its own CollectivIQ thread, exactly as before, and no reuse Redis
# operation ever runs.
#
# When enabled, sequential ELIGIBLE messages from one OpenCode session reuse ONE
# CollectivIQ thread instead of creating one per completion. A request is
# eligible only when ALL of these hold:
#   * this setting is true;
#   * the request carries a valid X-CollectivIQ-OpenCode-Session-ID header;
#   * the resolved virtual model uses promptMode: direct;
#   * the resolved virtual model uses toolMode: disabled.
# Every other request — no header, a protocol-mode model, or a tool-enabled
# model — stays stateless and byte-for-byte unchanged.
#
# Setting this to true REQUIRES a valid REDIS_URL above (and therefore
# IDEMPOTENCY_ENCRYPTION_KEY, from which SEPARATE thread-reuse subkeys are
# derived). Startup fails with a value-free error otherwise. Only "true" or
# "false" are accepted. No new secret is introduced.
#
# It is FAIL-CLOSED: an unavailable Redis, corrupt or ambiguous mapping state,
# or a failed transition returns 503 thread_reuse_unavailable + Retry-After: 2
# rather than silently starting a replacement thread. A second concurrent turn
# for the same session returns 409 thread_reuse_busy + Retry-After: 2. An
# eligible request that ALSO supplies Idempotency-Key is rejected with 400,
# because the two features cannot be combined in this initial implementation.
#
# This is NOT production ready: the remaining Phase 4 controls (load testing, the
# broader security review, dependency scanning, runbooks) are still outstanding,
# and upstream message ordering, pagination, thread cleanup, and retention remain
# unverified.
#
# Before enabling, know two things:
#   * Answers are matched by run id: every completion records the
#     combined_run_id its submission returned and accepts only messages carrying
#     that same id, so a reused thread cannot yield an earlier turn's answer. If
#     your account's process_message omits combined_run_id the submission fails
#     as an upstream protocol error; if its messages omit it, every turn times
#     out with 504.
#   * In direct mode the gateway sends only the latest user message. Without
#     reuse the provider therefore has no history and OpenCode's transcript is
#     the only conversation state; WITH reuse the provider accumulates the
#     session's turns and answers with them in view. The two are never
#     reconciled, so an edited or truncated client transcript can diverge from
#     what the provider remembers.
#
# ALL replicas must share the same REDIS_URL, IDEMPOTENCY_ENCRYPTION_KEY,
# REDIS_KEY_PREFIX, COLLECTIVIQ_GATEWAY_KEYS, upstream credentials, and model
# configuration, or a session will not resolve to the same mapping everywhere.
OPENCODE_THREAD_REUSE_ENABLED=false

# Sliding idle lifetime of a session-to-thread mapping, in ms
# (300000-2592000000; default 7 days). Every completion that uses the mapping
# resets it. Expiry only forgets the mapping — it NEVER deletes the CollectivIQ
# thread, which remains in the provider's sidebar under the provider's own
# retention policy. There is deliberately NO cap on the number of turns a
# mapping may serve.
OPENCODE_THREAD_REUSE_TTL_MS=604800000

# ---------------------------------------------------------------------------
# OPTIONAL observability. BOTH are OFF by default, and off means genuinely
# inert: no Prometheus registry, no GET /metrics route (the endpoint returns
# 404), no tracer, no exporter, no timer, no socket, no per-request telemetry
# allocation, and no call into either port. What remains is one fixed boolean
# check per call site — the claim is "no telemetry objects, samples, or
# closures", not "zero instructions". Neither feature needs Redis, a credential,
# or any other feature, and neither introduces a new secret.

# Exposes GET /metrics with the bounded Prometheus metrics of specification
# section 23.2. Only "true" or "false" are accepted.
#
# THE ENDPOINT IS UNAUTHENTICATED WHEN ENABLED, AND ISOLATING IT IS YOUR JOB.
# It sits outside /v1 and performs no gateway-key check: a scrape credential
# would be a second secret to distribute and rotate, and the process cannot
# verify whether the interface it is bound to is private. Bind to loopback and
# scrape locally, expose it only on a private network, or firewall it to the
# scraper — never publish it on a public listener.
#
# The exposition contains no prompt, answer, path, tool argument, credential, or
# identifier (every label is a closed vocabulary or a configured virtual-model
# id), but it does reveal traffic volumes, latencies, error categories, and your
# configured model ids.
METRICS_ENABLED=false

# Opt-in OpenTelemetry tracing over OTLP/HTTP: the nine manual spans of
# specification section 23.3, with no automatic instrumentation and no trace
# header ever sent to CollectivIQ. Only "true" or "false" are accepted, and
# "true" REQUIRES TRACING_OTLP_ENDPOINT below.
TRACING_ENABLED=false

# The collector's traces endpoint. Must be a CANONICAL absolute http(s) URL of
# at most 2048 UTF-8 bytes, with no query or fragment (not even a bare trailing
# "?" or "#") and a NON-ROOT path —
# supply the full traces path, because a bare origin such as
# http://127.0.0.1:4318 or a root-only https://collector/ is rejected. Any path
# is accepted, not just /v1/traces, so a collector fronted on a custom route
# works. A present value is validated even while tracing is disabled, so a broken
# endpoint fails at startup rather than on the day you switch tracing on.
#
# The gateway sends NO exporter authentication header (none is configurable
# yet), so the collector must be reachable only from the gateway's own network.
# Prefer https:// wherever the link is not private.
#
# An endpoint embedding credentials (https://user:pass@collector/v1/traces) is
# REJECTED: the gateway would never send them, so such a value could only park a
# secret in a setting that is not handled as one. Configuration errors never echo
# the endpoint, and it is redacted from logs.
#
# OTEL_* environment variables are INERT AT CONSTRUCTION. The SDK would normally
# read them as a fallback (OTEL_EXPORTER_OTLP_HEADERS could attach a credential
# to every export, and a client-certificate variable would read a file at
# startup), so the gateway builds every SDK object with them removed from the
# environment. Configure tracing only through the four settings in this block,
# and prefer setting no OTEL_* variable at all.
TRACING_OTLP_ENDPOINT=

# Root-span sampling probability: a plain decimal in [0, 1] (default 1 = sample
# every root span). An exponent, hexadecimal, NaN, Infinity, or a thousands
# separator is REJECTED rather than reinterpreted, so a mistyped probability
# cannot silently disable or saturate tracing.
TRACING_SAMPLE_RATIO=1
