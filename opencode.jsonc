{
  "$schema": "https://opencode.ai/config.json",

  // This key authenticates OpenCode to the local gateway. It must match one
  // entry in COLLECTIVIQ_GATEWAY_KEYS; it is not a CollectivIQ upstream key.
  "provider": {
    "collectiviq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CollectivIQ Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:COLLECTIVIQ_GATEWAY_KEY}",
        "timeout": 110000,
        "chunkTimeout": 30000,
      },
      // The consensus/coder/fast virtual models remain declared for accounts
      // whose CollectivIQ routing supports non-Claude sources. For THIS account,
      // upstream routing currently classifies generic gateway prompts as
      // Atlassian queries and skips non-Claude sources, so only collectiviq-claude
      // is observed to answer — hence the Claude-only defaults below.
      "models": {
        "collectiviq-claude": {
          "name": "CollectivIQ Claude",
        },
        "collectiviq-consensus": {
          "name": "CollectivIQ Consensus",
        },
        "collectiviq-coder": {
          "name": "CollectivIQ Coder",
        },
        "collectiviq-fast": {
          "name": "CollectivIQ Fast",
        },
      },
    },
  },

  // The gateway is text-only: it accepts non-streamed JSON and synthetic SSE
  // (`stream:true`). OpenCode automatically attaches tool DEFINITIONS to every
  // request even when every tool permission is denied. A text-only
  // (`toolMode: disabled`) virtual model TOLERATES that metadata as a
  // compatibility bridge — it is bounded (≤128 tools and ≤2 MiB aggregate JSON),
  // examined only through data-property descriptors for shape/byte accounting
  // (never executing getters/toJSON), never serialized into the CollectivIQ
  // prompt, never forwarded upstream, and never turned into a tool call — so
  // denying all permissions plus discarding the definitions keeps every request
  // within the supported text-only surface. Actual tool calling stays disabled
  // (Phase 3).
  "agent": {
    "collectiviq-text": {
      "description": "Text-only CollectivIQ agent (Claude source; no tools; Phase 2 SSE).",
      "mode": "primary",
      "model": "collectiviq/collectiviq-claude",
      "permission": {
        "*": "deny",
      },
    },
  },
  "default_agent": "collectiviq-text",

  // Claude is the committed default for foreground and hidden (small_model) work
  // because it is the only source currently observed to answer for this account.
  "model": "collectiviq/collectiviq-claude",
  "small_model": "collectiviq/collectiviq-claude",
  "share": "disabled",
}
