{
  "$schema": "https://opencode.ai/config.json",

  // This key authenticates OpenCode to the local gateway. It must match one
  // entry in COLLECTIVIQ_GATEWAY_KEYS; it is not a CollectivIQ upstream key.
  "provider": {
    "collectiviq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CollectivIQ Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:COLLECTIVIQ_GATEWAY_KEY}",
        "timeout": 110000,
        "chunkTimeout": 30000,
      },
      "models": {
        "collectiviq-claude": {
          "name": "CollectivIQ Claude",
        },
        "collectiviq-consensus": {
          "name": "CollectivIQ Consensus",
        },
        "collectiviq-coder": {
          "name": "CollectivIQ Coder",
        },
        "collectiviq-fast": {
          "name": "CollectivIQ Fast",
        },
      },
    },
  },

  // Phase 2 is text-only: the gateway accepts non-streamed JSON and synthetic
  // SSE (`stream:true`) but rejects tools/tool_choice/tool messages. This primary
  // agent denies every tool permission so OpenCode sends no tool definitions to
  // the gateway, keeping requests within the supported text-only surface.
  "agent": {
    "collectiviq-text": {
      "description": "Text-only CollectivIQ consensus agent (no tools; Phase 2 SSE).",
      "mode": "primary",
      "model": "collectiviq/collectiviq-consensus",
      "permission": {
        "*": "deny",
      },
    },
  },
  "default_agent": "collectiviq-text",

  "model": "collectiviq/collectiviq-consensus",
  "small_model": "collectiviq/collectiviq-fast",
  "share": "disabled",
}
