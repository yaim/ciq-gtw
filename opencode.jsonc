{
  "$schema": "https://opencode.ai/config.json",

  // This key authenticates OpenCode to the local gateway. It must match one
  // entry in COLLECTIVIQ_GATEWAY_KEYS; it is not a CollectivIQ upstream key.
  "provider": {
    "collectiviq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CollectivIQ Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:COLLECTIVIQ_GATEWAY_KEY}",
        "timeout": 110000,
        "chunkTimeout": 30000,
      },
      // The consensus/coder/fast virtual models remain declared for accounts
      // whose CollectivIQ routing supports non-Claude sources. For THIS account,
      // upstream routing currently classifies generic gateway prompts as
      // Atlassian queries and skips non-Claude sources, so only Claude sources
      // are observed to answer — hence the Claude-only defaults below.
      //
      // collectiviq-claude-direct is a Claude source with promptMode: direct: it
      // submits only the latest user-message content verbatim, WITHOUT the
      // gateway protocol wrapper, JSON envelope, role labels, or any
      // system/developer/assistant/earlier-user content. It is the foreground/
      // small_model default because the account observed to reject the protocol
      // wrapper as embedded identity/instruction manipulation; it is intentionally
      // lossy (no system/developer instructions or conversation history). A
      // sanitized 2026-08-18 smoke OBSERVED it resolve that refusal FOR THE TESTED
      // ACCOUNT (valid answer to a natural coding request); that is a single-account
      // observation, not production readiness or a repeatable upstream guarantee.
      "models": {
        "collectiviq-claude": {
          "name": "CollectivIQ Claude",
        },
        "collectiviq-claude-direct": {
          "name": "CollectivIQ Claude Direct",
        },
        "collectiviq-consensus": {
          "name": "CollectivIQ Consensus",
        },
        "collectiviq-coder": {
          "name": "CollectivIQ Coder",
        },
        "collectiviq-fast": {
          "name": "CollectivIQ Fast",
        },
        // Supported opt-in BETA emulated tool-calling model. The two committed
        // tool-enabled agent entries below expose this model: the canonical
        // collectiviq-tools-beta and its deprecated
        // collectiviq-tools-experimental compatibility alias. Because the model
        // is declared in this catalog it can also be selected directly (for
        // example `--model collectiviq/collectiviq-claude-tools`), so those two
        // agents are not its exclusive access path; what matters is that no
        // committed default selects the model or either agent. It must remain
        // non-default until a separate default-enablement decision is recorded
        // in spec section 30 after the relevant Phase 4 controls. The gateway
        // returns model-PROPOSED tool calls but never executes, authorizes, or
        // simulates a tool; OpenCode still owns permissions and execution. All
        // eight release gates in spec section 30 were measured live on
        // 2026-09-01 and passed; beta does NOT mean production-ready,
        // repeatable, or verified across accounts or versions.
        "collectiviq-claude-tools": {
          "name": "CollectivIQ Claude (Tools, beta)",
        },
      },
    },
  },

  // The gateway is text-only: it accepts non-streamed JSON and synthetic SSE
  // (`stream:true`). OpenCode automatically attaches tool DEFINITIONS to every
  // request even when every tool permission is denied. A text-only
  // (`toolMode: disabled`) virtual model TOLERATES that metadata as a
  // compatibility bridge — it is bounded (≤128 tools and ≤2 MiB aggregate JSON),
  // examined only through data-property descriptors for shape/byte accounting
  // (never executing getters/toJSON), never serialized into the CollectivIQ
  // prompt, never forwarded upstream, and never turned into a tool call — so
  // denying all permissions plus discarding the definitions keeps every request
  // within the supported text-only surface. Tool CALLING stays disabled for
  // collectiviq-text and every other `toolMode: disabled` model — which is every
  // model the committed default_agent, model, and small_model select. Emulated
  // tool calling (Phase 3) is supported opt-in beta and activates only when the
  // collectiviq-claude-tools model is explicitly chosen — normally by selecting
  // one of the two tool-enabled agent entries below (the canonical
  // collectiviq-tools-beta, or its behaviorally identical deprecated
  // collectiviq-tools-experimental alias), which also supply the wildcard "ask"
  // permission prompt that gates every proposed call.
  "agent": {
    "collectiviq-text": {
      "description": "Text-only CollectivIQ agent (Claude direct source; no tools; Phase 2 SSE).",
      "mode": "primary",
      "model": "collectiviq/collectiviq-claude-direct",
      "permission": {
        "*": "deny",
      },
    },
    // Supported opt-in BETA emulated tool-calling agent (NOT the default). It uses
    // the collectiviq-claude-tools (toolMode: emulated) model, which asks
    // CollectivIQ to emit a strict tool-or-final JSON envelope that the gateway
    // parses into OpenAI tool_calls. The gateway NEVER executes, authorizes, or
    // simulates a tool — it only returns the model's proposed calls; OpenCode
    // performs the permission prompt (wildcard "ask" below) and the actual tool
    // execution. Emulated tool mode graduated from experimental to supported
    // opt-in beta after the completed 2026-09-01 live campaign in which all eight
    // .agent/docs/tech-software-spec.md section-30 gates passed. Beta is NOT
    // production-ready: one passing campaign is not repeatability, a cross-account
    // guarantee, or a cross-version guarantee, and enabling tool mode by default
    // stays a separate decision after the Phase 4 controls. In emulated mode the
    // validated tool schemas, prior tool arguments, and prior tool results ARE
    // serialized into the prompt sent to CollectivIQ (never logged or retained by
    // the gateway); each tool-loop round creates a new upstream thread. The tested
    // account may still reject the protocol wrapper — do not change the default or
    // weaken parsing to work around that.
    "collectiviq-tools-beta": {
      "description": "Supported beta emulated tool calling (opt-in; proposed calls only; OpenCode owns permissions/execution).",
      "mode": "primary",
      "model": "collectiviq/collectiviq-claude-tools",
      "permission": {
        "*": "ask",
      },
    },
    // DEPRECATED compatibility alias for collectiviq-tools-beta, kept so existing
    // local workflows keep resolving. It is a fully functional second tool-enabled
    // agent entry, not a disabled stub: its model, mode, and wildcard permission
    // are IDENTICAL to collectiviq-tools-beta above, so it is the same behavior
    // under the former name rather than a different or older tool surface. New
    // usage must select collectiviq-tools-beta. This alias is retained through
    // Phase 4; removing it requires a separately announced breaking configuration
    // change.
    "collectiviq-tools-experimental": {
      "description": "DEPRECATED alias for collectiviq-tools-beta (identical behavior; select collectiviq-tools-beta for new usage).",
      "mode": "primary",
      "model": "collectiviq/collectiviq-claude-tools",
      "permission": {
        "*": "ask",
      },
    },
    // OpenCode's built-in hidden `title` agent would generate a short session
    // title with its OWN separate completion request (and thus a separate upstream
    // CollectivIQ thread). It is DISABLED here so no separate title thread/
    // completion is ever created. Note: `disable: true` turns off the hidden LLM
    // title-generation agent — do NOT rely on `OPENCODE_DISABLE_TERMINAL_TITLE`
    // for this, which only controls terminal-title RENDERING, not hidden LLM title
    // generation.
    //
    // In place of that hidden agent, the plugin
    // `.opencode/plugins/collectiviq-native-title.ts` (committed project-local by
    // default; optionally installed globally via a supported manual symlink for
    // cross-project use — see README — and process-wide idempotent across both
    // loads) asynchronously fetches the NATIVE, server-generated CollectivIQ title
    // of the session's first foreground thread (via the gateway's
    // `/opencode/session-title` endpoint) and applies it to the OpenCode session —
    // reusing the foreground thread instead of creating an extra one. The plugin's
    // entry module default-exports the OpenCode V1 `{ id, server }` object so
    // OpenCode 1.18.21's loader invokes only `default.server` and never scans the
    // module's named exports. (Historical 2026-08-21 sequence: the plugin's earlier
    // bare-function default fell through to OpenCode's legacy export scan, which
    // rejected a non-function runtime export with `Plugin export is not a function`,
    // so the plugin never loaded and no rename ran; then, after that loader fix, the
    // poller resolved its gateway key only from an absent env var. Both are fixed:
    // the V1 default module, and reuse of the resolved CollectivIQ provider
    // `options.apiKey` with the env var kept as a lazy fallback. A sanitized,
    // user-authorized 2026-08-22 live smoke observed the COMPLETE path succeed for
    // the tested local configuration on OpenCode 1.18.21 — one foreground thread, no
    // hidden title thread, a provider-native title generated, and the OpenCode
    // session title changed from its default to that title. This is a single-local-
    // configuration observation, not a production/cross-account/cross-version
    // guarantee; further live runs stay approval-gated. The descriptor-safe flat
    // `provider.id` / nested `provider.info.id` matching is offline hardening, not
    // the proven live cause.) This OpenCode session title is unrelated to the CollectivIQ
    // upstream thread title: the gateway always sends the fixed content-free
    // placeholder `New Thread`, which CollectivIQ may asynchronously replace with
    // its own prompt-related, server-generated title. The gateway reads that
    // correlated native title only TRANSIENTLY, through the extension endpoint, to
    // answer this plugin; it never logs, caches, or retains it, and the plugin
    // receives it only through that authenticated gateway endpoint.
    //
    // `collectiviq-fast` remains declared in the provider model catalog below for
    // manual/other-account use. The historical sanitized 2026-08-18 observation
    // that a `collectiviq-fast` title request succeeded on its first attempt for
    // one account remains historical evidence, not a current routing guarantee.
    "title": {
      "disable": true,
    },
  },
  "default_agent": "collectiviq-text",

  // The Claude direct profile is the committed default for foreground and hidden
  // (small_model) work: Claude is the only source observed to answer for this
  // account, and the direct prompt profile drops the gateway protocol wrapper the
  // account objected to. It is intentionally lossy (no system/developer
  // instructions or conversation history); a sanitized 2026-08-18 smoke observed it
  // resolve that refusal for the tested account (single-account observation, not
  // production readiness or a repeatable guarantee).
  "model": "collectiviq/collectiviq-claude-direct",
  "small_model": "collectiviq/collectiviq-claude-direct",
  "share": "disabled",
}
